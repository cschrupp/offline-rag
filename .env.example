# OfflineRAG core runtime requires no cloud API keys.
# Default topology: one OfflineRAG container + Ollama running locally on the host.

OFFLINE_RAG_CONFIG=config/base.yaml
OFFLINE_RAG_DATA_DIR=/data
OFFLINE_RAG_MODELS_DIR=/models
OFFLINE_RAG_QDRANT_DIR=/data/qdrant

OFFLINE_RAG_STRICT_OFFLINE=true
OFFLINE_RAG_LLM_BASE_URL=http://host.docker.internal:11434/v1
OFFLINE_RAG_LLM_MODEL=REPLACE_WITH_APPROVED_LOCAL_MODEL
# Comma-separated exact identifiers accepted by strict-offline preflight.
OFFLINE_RAG_APPROVED_LLM_MODELS=REPLACE_WITH_APPROVED_LOCAL_MODEL

# Retrieval model loaders should be configured for local-only access at runtime.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
