# OfflineRAG local environment (gitignored).
# Copy from .env.example and fill in secrets. Existing shell env vars win over this file.
# The CLI loads `.env` from cwd on startup.

OFFLINE_RAG_CONFIG=config/base.yaml
OFFLINE_RAG_DATA_DIR=/data
OFFLINE_RAG_MODELS_DIR=/models
OFFLINE_RAG_QDRANT_DIR=/data/qdrant

OFFLINE_RAG_STRICT_OFFLINE=true

# Generation — OpenAI-compatible local runtime (Ollama or Unsloth Studio)
# Ownership: operator (default when omitted) keeps environment values authoritative
# and locks corresponding Settings fields. Use user to treat environment values
# as bootstrap values and let saved generation Settings take precedence.
# User mode is intended for trusted local installations. Exposing the
# unauthenticated Settings API to untrusted network clients is unsafe.
OFFLINE_RAG_GENERATION_SETTINGS_MODE=user
OFFLINE_RAG_LLM_BASE_URL=http://127.0.0.1:11434/v1
OFFLINE_RAG_LLM_MODEL=qwen3.5:9b
OFFLINE_RAG_LLM_TIMEOUT_SECONDS=300
OFFLINE_RAG_APPROVED_LLM_MODELS=qwen3.5:9b
OFFLINE_RAG_APPROVED_LLM_ENDPOINTS=http://127.0.0.1:11434/v1
# Optional Bearer token (Unsloth Studio uses sk-unsloth-…). Empty = no Authorization header.
OFFLINE_RAG_LLM_API_KEY=

# When OfflineRAG itself runs in Docker and the generator is on the host:
# OFFLINE_RAG_LLM_BASE_URL=http://host.docker.internal:11434/v1
# OFFLINE_RAG_APPROVED_LLM_ENDPOINTS=http://host.docker.internal:11434/v1

# Unsloth Studio example:
# OFFLINE_RAG_LLM_BASE_URL=http://127.0.0.1:8888/v1
# OFFLINE_RAG_LLM_MODEL=<id from GET /v1/models>
# OFFLINE_RAG_APPROVED_LLM_MODELS=<same id>
# OFFLINE_RAG_APPROVED_LLM_ENDPOINTS=http://127.0.0.1:8888/v1
# OFFLINE_RAG_LLM_API_KEY=sk-unsloth-...

# Gold authoring — used by Gold Lab baseline bootstrap.
# Authoring is intentionally configured independently from normal generation.
# Ownership defaults to operator: environment values remain authoritative and
# lock their Settings controls. Use user to make them first-run values that
# saved Gold Lab Authoring Settings override after restart.
OFFLINE_RAG_AUTHORING_SETTINGS_MODE=operator
# For a simple local installation it may use the same OpenAI-compatible
# endpoint/model as generation.
OFFLINE_RAG_AUTHORING_ENABLED=true
OFFLINE_RAG_AUTHORING_BASE_URL=http://127.0.0.1:11434/v1
OFFLINE_RAG_AUTHORING_MODEL=qwen3.5:9b
OFFLINE_RAG_AUTHORING_NETWORK_POLICY=localhost_only
OFFLINE_RAG_AUTHORING_APPROVED_ENDPOINTS=http://127.0.0.1:11434/v1
OFFLINE_RAG_AUTHORING_APPROVED_MODELS=qwen3.5:9b
OFFLINE_RAG_AUTHORING_TIMEOUT_SECONDS=300
# Optional Bearer token. In operator mode, presence (even when empty) locks
# API-key ownership away from product Settings. In user mode, it is a bootstrap
# value that Settings can keep, replace, or clear. Omit it for no bootstrap key.
# OFFLINE_RAG_AUTHORING_API_KEY=

# Docker-host generator (OfflineRAG in Docker, generator on host):
# OFFLINE_RAG_AUTHORING_BASE_URL=http://host.docker.internal:11434/v1
# OFFLINE_RAG_AUTHORING_APPROVED_ENDPOINTS=http://host.docker.internal:11434/v1
# OFFLINE_RAG_AUTHORING_NETWORK_POLICY=localhost_only

# Private LAN generator:
# OFFLINE_RAG_AUTHORING_BASE_URL=http://192.168.1.50:8888/v1
# OFFLINE_RAG_AUTHORING_APPROVED_ENDPOINTS=http://192.168.1.50:8888/v1
# OFFLINE_RAG_AUTHORING_NETWORK_POLICY=private_network

# Embedding execution device policy (auto | cpu | cuda). When set, Compute
# Settings cannot change it (operator controlled). Omit to allow product Settings.
# OFFLINE_RAG_EMBEDDING_DEVICE=auto

# Hugging Face Hub token for provisioning downloads (embedding / reranker).
HF_TOKEN=

# Retrieval model loaders: enable offline mode only after artifacts are provisioned.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
