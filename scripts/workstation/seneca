#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/seneca/app"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/seneca"
ENV_FILE="$CONFIG_DIR/workstation.env"
SERVICE="seneca.service"

usage() {
  cat <<'EOF'
Usage: seneca {start|stop|restart|status|logs|doctor|enable-cuda|disable-cuda}

  start    Start the per-user systemd service
  stop     Stop the per-user systemd service
  restart  Restart the per-user systemd service
  status   Show service status
  logs     Follow service journal (Ctrl-C to stop)
  doctor   Run the installed offline-rag doctor command
  enable-cuda  Build and validate an optional CUDA release (explicit consent)
  disable-cuda Restore the retained CPU release without deleting model assets
EOF
}

command_name="${1:-}"
shift || true
case "$command_name" in
  start|stop|restart)
    exec systemctl --user "$command_name" "$SERVICE" "$@"
    ;;
  status)
    exec systemctl --user status --no-pager "$SERVICE" "$@"
    ;;
  logs)
    exec journalctl --user --unit "$SERVICE" --follow --no-pager "$@"
    ;;
  doctor)
    if [[ ! -r "$ENV_FILE" ]]; then
      printf 'Seneca settings not found: %s\nRun the workstation installer first.\n' "$ENV_FILE" >&2
      exit 1
    fi
    # The CLI loads a .env from its current directory. Use the installed
    # release so an unrelated project checkout cannot override workstation
    # diagnostics with its development environment.
    cd "$APP_DIR"
    exec "$APP_DIR/.venv/bin/python" "$APP_DIR/scripts/workstation/configure.py" \
      exec-env --path "$ENV_FILE" -- \
      "$APP_DIR/.venv/bin/offline-rag" doctor \
      --config "$APP_DIR/config/base.yaml" "$@"
    ;;
  enable-cuda|disable-cuda)
    exec "$APP_DIR/.venv/bin/python" "$APP_DIR/scripts/workstation/runtime.py" \
      "$command_name" "$@"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
